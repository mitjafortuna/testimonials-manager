APP_ENV=dev
# 1 shows exception messages in 500 responses — set 0 on any shared instance
APP_DEBUG=1
DB_HOST=db
DB_PORT=3306
DB_NAME=testimonials
DB_USER=app
DB_PASS=app
TEST_DB_NAME=testimonials_test
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_BYTES=5242880
LANDINGS_API_URL=https://develop.s-mania.com/it/testimonials/landings-api.php
LANDINGS_API_KEY=replace-me
# Path to a captured landings JSON; when set, sync reads it instead of calling the upstream API (used by tests)
LANDINGS_API_FIXTURE=
SESSION_NAME=tm_session
API_BASE_URL=http://localhost
# Per-IP request throttling; login gets its own tighter bucket
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_API=120
RATE_LIMIT_API_WINDOW=60
